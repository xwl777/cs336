{
    "train_data": "../out/tokens/ts-train/tokens.bin",
    "eval_data": "../out/tokens/ts-valid/tokens.bin",

    "device": "cuda",
    "dtype": "float32",

    "batch_size": 128,
    "context_length": 256,
    "max_iter": 10000,
    "grad_acc_step": 1,

    "lr_max": 0.02,
    "lr_min": 0.00001,
    "T_warmup": 1000,
    "T_cos": 10000,

    "max_norm": 1.0,

    "checkpoint_interval": 10000,
    "eval_interval": 500,
    "num_eval_batch": 50,

    "run_dir": "../TinyStories/lr2e-2",
    "seed": 42,

    "use_swanlab": true,
    "swanlab_project_name": "cs336-a1",
    "swanlab_name": "lr2e-2",

    "model": {
      "vocab_size": 10000,
      "context_length": 256,
      "d_model": 512,
      "num_layers": 4,
      "num_heads": 16,
      "d_ff": 1344,
      "rope_theta": 10000
    },

    "optimizer": {
      "lr": 0.001,
      "weight_decay": 0.01,
      "betas": [0.9, 0.95],
      "eps": 0.00000001
    }
  }